# Copy this to .env and fill in real values for local dev
# Railway sets these automatically in the dashboard — never commit .env

# ── Flask ─────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────
# Production (Fly.io): the `draftvision-db` Postgres cluster is attached to
# the `draftvision` app, which injects DATABASE_URL as a Fly secret — the
# backend auto-detects it and switches from SQLite to Postgres (psycopg2).
# Never put the production URL here or in .env; it lives only in Fly secrets.
# Locally: leave blank to use SQLite (players.db)
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Leave as * for development; set to your real domain in production
FRONTEND_ORIGIN=*

# ── Domain / URL normalization ────────────────────────────────────
# Optional: redirect all traffic to one canonical host and enforce HTTPS
# Example for production:
# CANONICAL_HOST=jkrek.com
# FORCE_HTTPS=true
CANONICAL_HOST=
FORCE_HTTPS=false

# ── Auth0 (optional) ─────────────────────────────────────────────
# Frontend (Create React App). Leave all three blank to run the app with
# login disabled entirely — the auth UI hides itself, everything else works.
REACT_APP_AUTH0_DOMAIN=
REACT_APP_AUTH0_CLIENT_ID=
# Optional: Auth0 API identifier — set only if the backend verifies tokens.
REACT_APP_AUTH0_AUDIENCE=
# Backend token verification (Flask) wants the matching pair:
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://your-api-identifier

# ── Feature flags ─────────────────────────────────────────────────
# Set to false to skip auto-sync on first boot (saves time on cold start)
AUTO_SYNC_COLLEGE_PROSPECTS=false
